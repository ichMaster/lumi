#!/usr/bin/env bash
# Manage the Lumi server from a shell (v2.2) — one-shot commands over the API, the token from secrets.yaml.
# Usage: ./lumi-cli status | memory show | memory clear | model [name] | model-set [profile] | serve
#        ./lumi-cli config [show | get <key> | set <key> <value> | validate] [--dir <settings folder>]   (v2.9)
cd "$(dirname "$0")" && exec uv run --all-extras python -m cli "$@"
